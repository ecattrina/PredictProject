@model IReadOnlyList<ConditionListRow>
@{
    ViewData["Title"] = "Условия оплаты";
    var contractId = ViewData["contractId"] as long?;
    var err = TempData["Error"] as string;
}

<h1 class="mb-3">Условия оплаты по договорам</h1>
@if (!string.IsNullOrEmpty(err))
{
    <div class="alert alert-danger">@err</div>
}
<p class="text-muted small mb-3">Те же правила, что и у <code>/api/contract-conditions</code> (пересечение периодов, удаление, если не используется в расчёте).</p>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-primary" asp-action="Create">Добавить условие</a>
</div>

<div class="card box-shadow mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-sm-4 col-md-3">
                <label class="form-label">ID договора</label>
                <input class="form-control" name="contractId" value="@contractId" type="number" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Фильтр</button>
            </div>
        </form>
    </div>
</div>

<div class="card box-shadow">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-sm mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Договор</th>
                        <th>С</th>
                        <th>По</th>
                        <th>Отсрочка (дн.)</th>
                        <th>Описание</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Id</td>
                        <td>@c.ContractNumber</td>
                        <td>@c.ValidFrom.ToString("dd.MM.yyyy")</td>
                        <td>@(c.ValidTo?.ToString("dd.MM.yyyy") ?? "—")</td>
                        <td>@c.PaymentDelayDays</td>
                        <td>@(c.Description ?? "—")</td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Изменить</a>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Удалить условие?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
