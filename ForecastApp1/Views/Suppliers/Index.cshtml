@model IReadOnlyList<SupplierListRow>
@{
    ViewData["Title"] = "Поставщики";
    var q = ViewData["q"] as string;
    var err = TempData["Error"] as string;
}

<h1 class="mb-3">Поставщики</h1>
@if (!string.IsNullOrEmpty(err))
{
    <div class="alert alert-danger">@err</div>
}
<p class="text-muted small mb-3">Код при создании уникален; после создания меняется только название (как в API).</p>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-primary" asp-action="Create">Добавить</a>
</div>

<div class="card box-shadow mb-3">
    <div class="card-body row g-2 align-items-end">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-sm-6 col-md-4">
                <label class="form-label">Поиск</label>
                <input class="form-control" name="q" value="@q" placeholder="код / название" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Обновить</button>
            </div>
        </form>
    </div>
</div>

<div class="card box-shadow">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-sm mb-0">
                <thead>
                    <tr><th>ID</th><th>Код</th><th>Название</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.Id</td>
                        <td>@s.SupplierCode</td>
                        <td>@s.Name</td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@s.Id">Изменить</a>
                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Удалить поставщика?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
