@model SupplierFormModel
@{
    ViewData["Title"] = "Поставщик — редактирование";
}

<h1 class="mb-3">Поставщик № @Model.Id</h1>

<div class="card box-shadow">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label class="form-label">Код</label>
                <input class="form-control" value="@Model.SupplierCode" readonly />
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Отмена</a>
        </form>
    </div>
</div>
