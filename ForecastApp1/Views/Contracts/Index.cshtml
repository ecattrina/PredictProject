@model IReadOnlyList<ContractListRow>
@{
    ViewData["Title"] = "Договоры";
    var q = ViewData["q"] as string;
    var supplierId = ViewData["supplierId"] as long?;
    var err = TempData["Error"] as string;
}

<h1 class="mb-3">Договоры</h1>
@if (!string.IsNullOrEmpty(err))
{
    <div class="alert alert-danger">@err</div>
}
<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-primary" asp-action="Create">Добавить договор</a>
</div>

<div class="card box-shadow mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-sm-4 col-md-3">
                <label class="form-label">ID поставщика</label>
                <input class="form-control" name="supplierId" value="@supplierId" type="number" />
            </div>
            <div class="col-sm-6 col-md-4">
                <label class="form-label">Поиск по номеру</label>
                <input class="form-control" name="q" value="@q" placeholder="внутренний номер" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Обновить</button>
            </div>
        </form>
    </div>
</div>

<div class="card box-shadow">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-sm mb-0">
                <thead>
                    <tr><th>ID</th><th>Поставщик</th><th>Внутр. №</th><th>Внеш. №</th><th>Дата</th><th>Сумма</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Id</td>
                        <td>@c.SupplierCode</td>
                        <td>@c.InternalContractNumber</td>
                        <td>@c.ExternalContractNumber</td>
                        <td>@(c.ContractDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                        <td>@(c.ContractAmount?.ToString("N2") ?? "—")</td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Изменить</a>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Удалить договор?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
