@model IReadOnlyList<ImportBatchListRow>
@{
    ViewData["Title"] = "Импорт Excel";
}

<h1 class="mb-3">Импорт Excel</h1>
<p class="text-muted small mb-3">
    Последние пакеты загрузки. Загрузить файл и подтвердить данные по-прежнему можно на странице
    <a href="~/import.html">import.html</a> и <a href="~/import-preview.html">import-preview.html</a>.
</p>

<div class="card box-shadow mb-3">
    <div class="card-body d-flex flex-wrap gap-2">
        <a class="btn btn-primary" href="~/import.html">Новая загрузка</a>
    </div>
</div>

<div class="card box-shadow">
    <div class="card-body">
        <h2 class="h5 card-title">Пакеты</h2>
        <div class="table-responsive">
            <table class="table table-striped table-sm mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Файл</th>
                        <th>Статус</th>
                        <th>Создан</th>
                        <th>Строк</th>
                        <th>Ошибок</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.Id</td>
                        <td>@b.OriginalFileName</td>
                        <td>@b.Status</td>
                        <td>@b.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td>@b.Rows</td>
                        <td>@b.Errors</td>
                        <td><a href="~/import-preview.html?id=@b.Id">Проверка</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
