@{
    ViewData["Title"] = "Справочники";
    var q = ViewData["q"] as string;
    var suppliers = ViewBag.Suppliers as IReadOnlyList<SupplierListRow> ?? Array.Empty<SupplierListRow>();
    var contracts = ViewBag.Contracts as IReadOnlyList<ContractListRow> ?? Array.Empty<ContractListRow>();
    var conditions = ViewBag.Conditions as IReadOnlyList<ConditionListRow> ?? Array.Empty<ConditionListRow>();
}

<h1 class="mb-3">Справочники</h1>
<p class="text-muted small mb-3">Поставщики, договоры и условия оплаты в одном разделе.</p>
<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-primary" asp-controller="Suppliers" asp-action="Create">Новый поставщик</a>
    <a class="btn btn-primary" asp-controller="Contracts" asp-action="Create">Новый договор</a>
    <a class="btn btn-primary" asp-controller="Conditions" asp-action="Create">Новое условие оплаты</a>
    <a class="btn btn-outline-primary" asp-controller="Suppliers" asp-action="Index">Все поставщики</a>
    <a class="btn btn-outline-primary" asp-controller="Contracts" asp-action="Index">Все договоры</a>
    <a class="btn btn-outline-primary" asp-controller="Conditions" asp-action="Index">Все условия оплаты</a>
</div>

<div class="card box-shadow mb-3">
    <div class="card-body row g-2 align-items-end">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-sm-6 col-md-4">
                <label class="form-label">Поиск</label>
                <input class="form-control" name="q" value="@q" placeholder="код / название / номер договора" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Обновить</button>
            </div>
        </form>
    </div>
</div>

<div class="card box-shadow mb-3">
    <div class="card-body">
        <h2 class="h5 card-title">Поставщики</h2>
        <div class="table-responsive">
            <table class="table table-striped table-sm mb-0">
                <thead>
                    <tr><th>ID</th><th>Код</th><th>Название</th></tr>
                </thead>
                <tbody>
                @foreach (var s in suppliers)
                {
                    <tr>
                        <td>@s.Id</td>
                        <td>@s.SupplierCode</td>
                        <td>@s.Name</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card box-shadow">
    <div class="card-body">
        <h2 class="h5 card-title">Договоры</h2>
        <div class="table-responsive">
            <table class="table table-striped table-sm mb-0">
                <thead>
                    <tr><th>ID</th><th>Поставщик</th><th>Договор</th><th>Внеш. №</th><th>Дата</th><th>Сумма</th></tr>
                </thead>
                <tbody>
                @foreach (var c in contracts)
                {
                    <tr>
                        <td>@c.Id</td>
                        <td>@c.SupplierCode</td>
                        <td>@c.InternalContractNumber</td>
                        <td>@c.ExternalContractNumber</td>
                        <td>@(c.ContractDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                        <td>@(c.ContractAmount?.ToString("N2") ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card box-shadow mt-3">
    <div class="card-body">
        <h2 class="h5 card-title">Условия оплаты</h2>
        <div class="table-responsive">
            <table class="table table-striped table-sm mb-0">
                <thead>
                    <tr><th>ID</th><th>Договор</th><th>Действует с</th><th>Действует по</th><th>Отсрочка, дн.</th><th>Описание</th></tr>
                </thead>
                <tbody>
                @foreach (var c in conditions)
                {
                    <tr>
                        <td>@c.Id</td>
                        <td>@c.ContractNumber</td>
                        <td>@c.ValidFrom.ToString("dd.MM.yyyy")</td>
                        <td>@(c.ValidTo?.ToString("dd.MM.yyyy") ?? "—")</td>
                        <td>@c.PaymentDelayDays</td>
                        <td>@(string.IsNullOrWhiteSpace(c.Description) ? "—" : c.Description)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
