    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ForecastApp1</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tools\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
